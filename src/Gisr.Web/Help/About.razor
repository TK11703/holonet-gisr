@page "/about"

<PageHeader Title="About GISR" Crumbs="Crumbs" />

<div class="about-page mx-auto">
    <section class="card home-hero mb-4" aria-labelledby="about-purpose">
        <div class="card-body p-4">
            <p class="home-eyebrow mb-2">HoloNet / Databank / GISR</p>
            <h2 id="about-purpose" class="h4 mb-3">An archive of identity and service</h2>
            <p class="text-secondary mb-2">
                The Galactic Identity and Service Records system (GISR) archives authoritative records for citizens,
                military personnel, Jedi, bounty hunters, and others. It is a fictional system within the HoloNet's Databank.
            </p>
            <p class="text-secondary mb-0">
                Citizens keep records about themselves. Officers can keep service records about others and seal them
                behind an override code. Every record carries its own history, and nothing is changed without a trace.
            </p>
        </div>
    </section>

    <section aria-labelledby="about-record" class="mb-5">
        <h2 id="about-record" class="h5 mb-3">What a record holds</h2>
        <div class="row g-3">
            <div class="col-md-6 col-xl-4">
                <article class="card h-100"><div class="card-body">
                    <h3 class="h6">Details</h3>
                    <p class="text-secondary small mb-0">A title, the affiliation the record is filed under, an optional engagement period, and a summary.</p>
                </div></article>
            </div>
            <div class="col-md-6 col-xl-4">
                <article class="card h-100"><div class="card-body">
                    <h3 class="h6">Incidents</h3>
                    <p class="text-secondary small mb-0">Dated events of note, each with a title and description. Officers add and remove them.</p>
                </div></article>
            </div>
            <div class="col-md-6 col-xl-4">
                <article class="card h-100"><div class="card-body">
                    <h3 class="h6">Awards</h3>
                    <p class="text-secondary small mb-0">Recognition with a name, the date awarded, and an optional issuer and description.</p>
                </div></article>
            </div>
            <div class="col-md-6 col-xl-4">
                <article class="card h-100"><div class="card-body">
                    <h3 class="h6">Artifacts</h3>
                    <p class="text-secondary small mb-0">Images and documents attached to the record. Images also appear in the gallery, grouped by record.</p>
                </div></article>
            </div>
            <div class="col-md-6 col-xl-4">
                <article class="card h-100"><div class="card-body">
                    <h3 class="h6">History</h3>
                    <p class="text-secondary small mb-0">Every save is kept as a revision showing who made it and when. Simultaneous edits are never silently overwritten.</p>
                </div></article>
            </div>
            <div class="col-md-6 col-xl-4">
                <article class="card h-100"><div class="card-body">
                    <h3 class="h6">Provenance</h3>
                    <p class="text-secondary small mb-0">Each record names its subject and its author, so a service record is always attributed to the Officer who wrote it.</p>
                </div></article>
            </div>
        </div>
    </section>

    <section aria-labelledby="about-roles" class="mb-5">
        <h2 id="about-roles" class="h5 mb-3">Citizens and Officers</h2>
        <p class="text-secondary">
            Everyone who signs in is a citizen. Officers hold a credential from the organization's identity provider
            that widens what they may see and do.
        </p>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">What citizens and Officers can do</caption>
                <thead>
                    <tr>
                        <th scope="col">Capability</th>
                        <th scope="col" class="text-center">Citizen</th>
                        <th scope="col" class="text-center">Officer</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (capability, citizen, officer) in Capabilities)
                    {
                        <tr>
                            <th scope="row" class="fw-normal">@capability</th>
                            <td class="text-center">@citizen</td>
                            <td class="text-center">@officer</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section aria-labelledby="about-protection" class="mb-5">
        <h2 id="about-protection" class="h5 mb-3">How records are protected</h2>
        <div class="row g-4">
            <div class="col-md-6">
                <h3 class="h6">Access is checked on the server</h3>
                <p class="text-secondary small mb-0">Your identity comes from your sign-in, never from anything you submit. A record you may not view looks exactly like a record that does not exist.</p>
            </div>
            <div class="col-md-6">
                <h3 class="h6">Sealed records</h3>
                <p class="text-secondary small mb-0">A sealed service record is hidden from its subject. They see only that it exists, and can read it for a single visit by entering the override code. Wrong codes are recorded and eventually blocked.</p>
            </div>
            <div class="col-md-6">
                <h3 class="h6">Accountability</h3>
                <p class="text-secondary small mb-0">When an Officer opens another person's record, GISR logs who and when. Override attempts and unlocks are logged too. Override codes are never stored in a readable form.</p>
            </div>
            <div class="col-md-6">
                <h3 class="h6">Files are verified</h3>
                <p class="text-secondary small mb-0">Uploads are checked against their real contents, limited to 25 MB each and 50 per record, and served only to people who may view the record.</p>
            </div>
        </div>
    </section>

    <section aria-labelledby="about-explore" class="mb-5">
        <h2 id="about-explore" class="h5 mb-3">Where to go</h2>
        <div class="row g-3">
            @foreach (var (title, text, href, label) in Destinations)
            {
                <div class="col-md-6 col-xl-4">
                    <article class="card h-100">
                        <div class="card-body d-flex flex-column align-items-start">
                            <h3 class="h6">@title</h3>
                            <p class="text-secondary small">@text</p>
                            <a href="@href" class="mt-auto small">@label<span class="ms-2" aria-hidden="true">&rarr;</span></a>
                        </div>
                    </article>
                </div>
            }
        </div>
    </section>

    <section aria-labelledby="about-search" class="mb-5">
        <h2 id="about-search" class="h5 mb-3">Search by meaning</h2>
        <p class="text-secondary mb-0 home-description">
            Search understands what you mean, not only the words you type. It reads record content and the text inside
            PDF, Word, plain-text, and Markdown files, including scanned PDFs within a monthly limit, and returns
            only what you are allowed to see. New content is usually searchable within a couple of minutes.
        </p>
    </section>

    <section aria-labelledby="about-fiction" class="mb-4">
        <h2 id="about-fiction" class="h5 mb-3">Fiction and real data</h2>
        <p class="text-secondary mb-2 home-description">
            Records, affiliations, and Chain Codes are works of fiction. Your sign-in, your Operating Number
            (kept by your organization as your EmployeeId), and the Officer credential are real directory data that
            GISR reads but cannot change.
        </p>
        <p class="text-secondary mb-0 home-description">
            Have a question? See the <a href="/faq">frequently asked questions</a>.
        </p>
    </section>

    <footer class="border-top pt-3 mt-5 d-flex flex-wrap justify-content-between gap-2 small text-secondary">
        <span>HoloNet / Databank / GISR</span>
        <span>Galactic Identity and Service Records</span>
    </footer>
</div>

@code {
    private static readonly Crumb[] Crumbs = [new("Home", "/"), new("Help"), new("About")];

    private static readonly (string Capability, string Citizen, string Officer)[] Capabilities =
    [
        ("Create and edit records about yourself", "Yes", "Yes"),
        ("View records written about you", "Yes, except sealed ones until unlocked", "Yes"),
        ("View other citizens' records", "No", "Yes"),
        ("Write service records about others", "No", "Yes"),
        ("Add or remove incidents", "No", "Yes"),
        ("Seal a service record", "No", "Yes"),
        ("Search and browse the gallery across all records", "No", "Yes"),
    ];

    private static readonly (string Title, string Text, string Href, string Label)[] Destinations =
    [
        ("Citizen records", "Browse, create, and edit records, and filter them by affiliation.", "/records", "Open records"),
        ("Gallery", "Browse images grouped by the record they belong to.", "/gallery", "Open the gallery"),
        ("Search", "Find records and files by meaning.", "/search", "Search the archive"),
        ("Account settings", "Manage preferences, affiliations, and your optional Chain Code.", "/account", "Open account settings"),
        ("Frequently asked questions", "Quick answers about records, sealing, files, search, and access.", "/faq", "Read the FAQ"),
    ];
}
