@page "/search"
@inject ApiClient Api
@inject CurrentUserState User
@inject NavigationManager Navigation

<PageHeader Title="Search and explore" Crumbs="Crumbs" />

<form role="search" class="row justify-content-center my-4 mb-5" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
    <div class="col-12 col-md-10 col-lg-8">
        <label for="search-query" class="visually-hidden">Search</label>
        <div class="input-group input-group-lg">
            <span class="input-group-text rounded-start-pill bg-body text-secondary"><Icon Name="search" /></span>
            <input id="search-query" type="search" class="form-control" maxlength="500" autocomplete="off"
                   placeholder="Search records and files by meaning..." @bind="_input" @bind:event="oninput" />
            <button type="submit" class="btn btn-primary rounded-end-pill">Search</button>
        </div>
    </div>
</form>

<div id="search-filters" class="border-top border-bottom py-3 mb-3">
    <div class="row g-3 align-items-center">
        <div class="col-12 col-lg text-secondary">
            @if (_state == SearchState.Results && _results is not null)
            {
                <p id="search-summary" class="mb-0" role="status">Found <span class="badge text-bg-primary">@_results.TotalCount</span> @(_results.TotalCount == 1 ? "result" : "results") for &quot;@_searched&quot;</p>
            }
        </div>
        <div class="col-12 col-lg-auto">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-sm-auto text-secondary small">Filter by:</div>
                @if (User.IsOfficer)
                {
                    <div class="col-12 col-sm-auto">
                        <label for="search-scope" class="visually-hidden">Records</label>
                        <select id="search-scope" class="form-select" value="@(_allScope ? "all" : "mine")"
                                @onchange="OnScopeChangedAsync">
                            <option value="all">All records</option>
                            <option value="mine">My Records</option>
                        </select>
                    </div>
                }
                <div class="col-12 col-sm-auto">
                    <label for="search-affiliation" class="visually-hidden">Affiliation</label>
                    <select id="search-affiliation" class="form-select" value="@_affiliation" @onchange="OnAffiliationChangedAsync">
                        <option value="">All affiliations</option>
                        @foreach (var affiliation in _affiliations)
                        {
                            <option value="@affiliation">@affiliation</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>

@if (_state == SearchState.Prompt)
{
    <p id="search-prompt" class="text-secondary">Enter at least 2 characters to search.</p>
}
else if (_state == SearchState.Loading)
{
    <p class="text-secondary" role="status">Searching...</p>
}
else if (_state == SearchState.Unavailable)
{
    <div id="search-unavailable" class="alert alert-warning d-flex align-items-center gap-3" role="alert">
        <span>Search is temporarily unavailable. Try again shortly.</span>
        <button type="button" id="search-retry" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="RetryAsync">Try again</button>
    </div>
}
else if (_state == SearchState.Failed)
{
    <div class="alert alert-danger" role="alert">The search could not be completed. Please try again.</div>
}
else if (_results is not null)
{
    @if (_results.TotalCount == 0)
    {
        <p id="search-empty" class="text-secondary">No results for &ldquo;@_searched&rdquo;. Try different words; search matches by meaning, not only exact text.</p>
    }
    else
    {
        <ul class="search-results list-unstyled">
            @foreach (var hit in _results.Items)
            {
                <li class="search-result border-bottom py-4">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <h2 class="h5 mb-0"><a class="search-result-link" href="/records/@hit.RecordId">@hit.RecordTitle</a></h2>
                            <span class="badge text-bg-secondary">@hit.Affiliation</span>
                            @if (hit.IsSealed)
                            {
                                <span class="badge text-bg-warning badge-sealed">Sealed</span>
                            }
                            <span class="small text-secondary ms-auto search-score" title="Similarity to your search">@ScoreText(hit.Score) match</span>
                        </div>
                        <div class="small text-secondary search-result-source">@(hit.SourceType == "artifact" ? $"File: {hit.ArtifactFileName}" : "Record")</div>
                        <p class="search-snippet mb-0 pre-wrap">
                            @foreach (var (text, match) in SearchHighlight.Split(hit.Snippet, _searched))
                            {
                                @if (match)
                                {
                                    <mark>@text</mark>
                                }
                                else
                                {
                                    @text
                                }
                            }
                        </p>
                </li>
            }
        </ul>

        @if (PageCount > 1)
        {
            <nav aria-label="Search pages" class="d-flex flex-wrap align-items-center gap-3">
                <button type="button" id="previous-page" class="btn btn-outline-secondary btn-sm" disabled="@(_pageNumber <= 1)" @onclick="PreviousAsync">Previous</button>
                <span>Page @_pageNumber of @PageCount</span>
                <button type="button" id="next-page" class="btn btn-outline-secondary btn-sm" disabled="@(_pageNumber >= PageCount)" @onclick="NextAsync">Next</button>
            </nav>
        }
    }
}

@code {
    private const int PageSize = 10;

    private enum SearchState
    {
        Prompt,
        Loading,
        Results,
        Unavailable,
        Failed,
    }

    private static readonly Crumb[] Crumbs = [new("Home", "/"), new("Search")];

    private IReadOnlyList<string> _affiliations = [];
    private PagedResult<SearchResultDto>? _results;
    private SearchState _state = SearchState.Prompt;
    private string _input = string.Empty;
    private string _searched = string.Empty;
    private string _affiliation = string.Empty;
    private string? _handledQuery;
    private int _pageNumber = 1;
    private bool _allScope;
    private bool _started;

    [Parameter, SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    private long PageCount => _results is null ? 1 : Math.Max(1, (_results.TotalCount + PageSize - 1) / PageSize);

    protected override async Task OnParametersSetAsync()
    {
        if (!_started)
        {
            _started = true;
            await LoadSupportDataAsync();
        }

        if (_handledQuery == Q)
        {
            return;
        }

        _handledQuery = Q;
        _input = Q ?? string.Empty;
        _pageNumber = 1;
        await SearchAsync();
    }

    private async Task LoadSupportDataAsync()
    {
        try
        {
            _affiliations = RecordDisplay.AffiliationLabels(await Api.GetAsync<List<AccountAffiliationDto>>("api/me/affiliations") ?? []);
        }
        catch (ApiException)
        {
            // Filters fall back to codes; searching still works.
        }

        try
        {
            await User.EnsureLoadedAsync();
            _allScope = User.IsOfficer;
        }
        catch (ApiException)
        {
            // Without the account the Officer-only scope switch stays hidden; the Api enforces access either way.
        }
    }

    private async Task SearchAsync()
    {
        var query = (Q ?? string.Empty).Trim();
        if (query.Length < 2)
        {
            _results = null;
            _state = SearchState.Prompt;
            return;
        }

        _searched = query;
        _state = SearchState.Loading;
        var path = $"api/search?q={Uri.EscapeDataString(query)}&page={_pageNumber}&pageSize={PageSize}";
        if (_affiliation.Length > 0)
        {
            path += $"&affiliation={Uri.EscapeDataString(_affiliation)}";
        }

        if (_allScope)
        {
            path += "&scope=all";
        }

        try
        {
            _results = await Api.GetAsync<PagedResult<SearchResultDto>>(path);
            _state = SearchState.Results;
        }
        catch (ApiException ex) when (ex.Status == StatusCodes.Status503ServiceUnavailable)
        {
            _results = null;
            _state = SearchState.Unavailable;
        }
        catch (ApiException)
        {
            _results = null;
            _state = SearchState.Failed;
        }
    }

    private async Task SubmitAsync()
    {
        var query = _input.Trim();
        if (query.Length < 2)
        {
            Q = query;
            _handledQuery = query;
            await SearchAsync();
            return;
        }

        if (string.Equals(query, Q, StringComparison.Ordinal))
        {
            _pageNumber = 1;
            await SearchAsync();
            return;
        }

        Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(query)}");
    }

    private async Task RetryAsync() => await SearchAsync();

    private async Task OnScopeChangedAsync(ChangeEventArgs e)
    {
        var all = string.Equals(e.Value?.ToString(), "all", StringComparison.Ordinal);
        if (_allScope == all)
        {
            return;
        }

        _allScope = all;
        _pageNumber = 1;
        await SearchAsync();
    }

    private async Task OnAffiliationChangedAsync(ChangeEventArgs e)
    {
        _affiliation = e.Value?.ToString() ?? string.Empty;
        _pageNumber = 1;
        await SearchAsync();
    }

    private async Task PreviousAsync()
    {
        _pageNumber--;
        await SearchAsync();
    }

    private async Task NextAsync()
    {
        _pageNumber++;
        await SearchAsync();
    }

    private static string ScoreText(double score) => $"{Math.Round(score * 100):0}%";
}
