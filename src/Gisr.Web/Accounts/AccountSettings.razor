@page "/account"
@implements IDisposable
@inject ApiClient Api
@inject CurrentUserState User
@inject ThemeInterop Theme

<PageHeader Title="Account settings" Crumbs="@Crumbs" />

@if (_loadError)
{
    <div class="alert alert-danger" role="alert">Your account settings could not be loaded. Please try again.</div>
}
else if (User.Account is null)
{
    <p class="text-secondary" role="status">Loading...</p>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <section class="card" aria-labelledby="settings-heading">
                <header class="card-header">
                    <h2 id="settings-heading" class="h6 mb-0">Preferences</h2>
                </header>
                <div class="card-body">

                    @if (_errors.Count > 0 || _saveFailed)
                    {
                        <div class="alert alert-danger" role="alert">
                            @if (_saveFailed)
                            {
                                <span>Your settings could not be saved. Please try again.</span>
                            }
                            else
                            {
                                <span>Please fix the highlighted fields.</span>
                            }
                        </div>
                    }
                    <EditForm id="account-settings-form" EditContext="_editContext" OnSubmit="SaveAsync" FormName="account-settings">
                        <div class="mb-3">
                            <label for="display-name" class="form-label">Display name</label>
                            <InputText id="display-name" class="@FieldClass("displayName")" @bind-Value="_model.DisplayName"
                                       aria-describedby="@Described("displayName", "display-name-error")" />
                            @if (_errors.TryGetValue("displayName", out var nameErrors))
                            {
                                <div id="display-name-error" class="invalid-feedback d-block">@string.Join(" ", nameErrors)</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label for="contact-email" class="form-label">Notification Account</label>
                            <InputText id="contact-email" type="email" class="@FieldClass("contactEmail")" @bind-Value="_model.ContactEmail"
                                       aria-describedby="@Described("contactEmail", "contact-email-error")" />
                            @if (_errors.TryGetValue("contactEmail", out var emailErrors))
                            {
                                <div id="contact-email-error" class="invalid-feedback d-block">@string.Join(" ", emailErrors)</div>
                            }
                        </div>

                        <div class="form-check mb-3">
                            <InputCheckbox id="notify" class="form-check-input" @bind-Value="_model.NotifyOnServiceRecord" />
                            <label for="notify" class="form-check-label">Notify me when a service record is created for me</label>
                        </div>

                        <div class="mb-3">
                            <label for="site-theme" class="form-label">Site theme</label>
                            <InputSelect id="site-theme" class="@SelectClass("theme")" @bind-Value="_model.Theme"
                                         aria-describedby="@Described("theme", "site-theme-error")"
                                         aria-invalid="@(_errors.ContainsKey("theme") ? "true" : null)">
                                @foreach (var option in SiteThemes.All)
                                {
                                    <option value="@option.Id">@option.Name</option>
                                }
                            </InputSelect>
                            @if (_errors.TryGetValue("theme", out var themeErrors))
                            {
                                <div id="site-theme-error" class="invalid-feedback d-block">@string.Join(" ", themeErrors)</div>
                            }
                        </div>

                    </EditForm>
                </div>
                <footer class="card-footer">
                    <button type="submit" form="account-settings-form" class="btn btn-primary d-inline-flex align-items-center gap-2" disabled="@_saving"><Icon Name="save" /> Save</button>
                    <div aria-live="polite" aria-atomic="true">
                        @if (_saved)
                        {
                            <div class="alert alert-success d-flex align-items-start gap-2 mt-3 mb-0 py-2" role="status">
                                <span class="flex-shrink-0"><Icon Name="check-circle" /></span>
                                <span>Preferences saved...</span>
                            </div>
                        }
                    </div>
                </footer>
            </section>
        </div>
        <div class="col-lg-4">
            <section class="card" aria-labelledby="identity-heading">
                <header class="card-header">
                    <h2 id="identity-heading" class="h6 mb-0">Account Information</h2>
                </header>
                <div class="card-body">
                    <div class="alert alert-info d-flex align-items-start gap-2" role="note">
                        <span class="flex-shrink-0"><Icon Name="info" /></span>
                        <span>These details come from the system's access control component and cannot be altered here.</span>
                    </div>
                    <dl id="identity" class="mb-0">
                        <dt>User Name</dt>
                        <dd>@(User.Account.SignInEmail ?? "Not provided")</dd>
                        <dt>Operating Number</dt>
                        <dd class="text-break">@(User.Account.OperatingNumber ?? "Not provided")</dd>
                        <dt>Access level</dt>
                        <dd><span class="badge d-inline-flex align-items-center gap-1 @(User.Account.IsOfficer ? "text-bg-success" : "text-bg-secondary")"><Icon Name="@(User.Account.IsOfficer ? "rank" : "user")" Size="14" />@(User.Account.IsOfficer ? "Officer" : "Citizen")</span></dd>
                    </dl>
                </div>
            </section>
        </div>
        <div class="col-lg-8">
            <ChainCodeForm />
        </div>
        <div class="col-lg-4">
            <AffiliationsCard />
        </div>
    </div>
}

@code {
    private sealed class SettingsModel
    {
        public string DisplayName { get; set; } = string.Empty;

        public string? ContactEmail { get; set; }

        public bool NotifyOnServiceRecord { get; set; }

        public string Theme { get; set; } = SiteThemes.Default;
    }

    private static readonly Crumb[] Crumbs = [new("Home", "/"), new("Account settings")];

    private SettingsModel _model = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messages = default!;
    private Dictionary<string, string[]> _errors = [];
    private bool _loadError;
    private bool _saved;
    private bool _saveFailed;
    private bool _saving;
    private readonly CancellationTokenSource _lifetime = new();
    private int _savedVersion;

    protected override async Task OnInitializedAsync()
    {
        ResetEditContext();
        User.Changed += OnUserChanged;
        try
        {
            await User.EnsureLoadedAsync();
            Reset();
        }
        catch (ApiException)
        {
            _loadError = true;
        }
    }

    private void Reset()
    {
        if (User.Account is { } account)
        {
            _model = new SettingsModel
            {
                DisplayName = account.DisplayName,
                ContactEmail = account.ContactEmail,
                NotifyOnServiceRecord = account.NotifyOnServiceRecord,
                Theme = SiteThemes.IsKnown(account.Theme) ? account.Theme : SiteThemes.Default,
            };
            ResetEditContext();
        }
    }

    private void ResetEditContext()
    {
        _editContext = new EditContext(_model);
        _messages = new ValidationMessageStore(_editContext);
    }

    private void OnUserChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;
        _saved = false;
        _savedVersion++;
        _saveFailed = false;
        _errors = [];
        _messages.Clear();

        try
        {
            var updated = await Api.PutAsync<Gisr.Shared.Accounts.AccountDto>(
                "api/me/settings",
                new Gisr.Shared.Accounts.UpdateAccountSettingsRequest(_model.DisplayName, _model.ContactEmail, _model.NotifyOnServiceRecord, _model.Theme),
                cancellationToken: _lifetime.Token);
            if (updated is not null)
            {
                User.Update(updated);
                await Theme.ApplyAsync(updated.Theme);
                _saved = true;
                _ = HideSavedAsync(++_savedVersion);
            }
        }
        catch (ApiException ex) when (ex.Status == 400)
        {
            _errors = ex.Errors.ToDictionary(e => e.Key, e => e.Value, StringComparer.Ordinal);
            foreach (var (field, messages) in _errors)
            {
                var property = field switch
                {
                    "displayName" => nameof(SettingsModel.DisplayName),
                    "contactEmail" => nameof(SettingsModel.ContactEmail),
                    "theme" => nameof(SettingsModel.Theme),
                    _ => null,
                };
                if (property is not null)
                {
                    _messages.Add(_editContext.Field(property), messages);
                }
            }

            _editContext.NotifyValidationStateChanged();
        }
        catch (ApiException)
        {
            _saveFailed = true;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally
        {
            _saving = false;
        }
    }

    private async Task HideSavedAsync(int version)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(5), _lifetime.Token);
            await InvokeAsync(() =>
            {
                if (!_lifetime.IsCancellationRequested && version == _savedVersion)
                {
                    _saved = false;
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    private string FieldClass(string field) => _errors.ContainsKey(field) ? "form-control is-invalid" : "form-control";

    private string SelectClass(string field) => _errors.ContainsKey(field) ? "form-select is-invalid" : "form-select";

    private string? Described(string field, string id) => _errors.ContainsKey(field) ? id : null;

    public void Dispose()
    {
        User.Changed -= OnUserChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
