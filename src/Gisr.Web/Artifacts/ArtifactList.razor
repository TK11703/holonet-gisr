@inject ApiClient Api

<div id="artifact-list">
    @if (_message is not null)
    {
        <div class="alert alert-danger" role="alert">@_message</div>
    }

    @if (_items is null)
    {
        @if (!_loadFailed)
        {
            <p class="text-secondary" role="status">Loading...</p>
        }
    }
    else if (_items.Count == 0)
    {
        <div id="artifacts-empty" class="alert alert-info d-flex align-items-start gap-2 mb-0" role="status">
            <span class="flex-shrink-0"><Icon Name="info" /></span>
            <span>No artifacts attached.</span>
        </div>
    }
    else
    {
        <ul class="artifact-grid list-unstyled mb-0">
            @foreach (var artifact in _items)
            {
                <li class="artifact-item" @key="artifact.Id">
                    <div class="artifact-tile">
                        <div class="artifact-preview">
                            @if (artifact.IsImage)
                            {
                                <a class="artifact-open" href="@ArtifactDisplay.MediaUrl(artifact.Id, false, ViewingId)" target="_blank" rel="noopener" title="@artifact.Description">
                                    <img class="artifact-thumb" src="@ArtifactDisplay.MediaUrl(artifact.Id, true, ViewingId)" alt="@artifact.Description" loading="lazy" />
                                </a>
                            }
                            else
                            {
                                <span class="artifact-icon"><Icon Name="file" Size="24" /></span>
                            }
                        </div>
                        <div class="d-flex align-items-start justify-content-between gap-2 min-w-0">
                            <div class="min-w-0">
                                <a class="artifact-download d-block text-truncate fw-semibold" href="@ArtifactDisplay.MediaUrl(artifact.Id, false, ViewingId)" download title="@($"{artifact.FileName} - uploaded by {artifact.UploadedByDisplayName} on {RecordDisplay.Instant(artifact.UploadedAt)}")">@artifact.FileName</a>
                                <div class="small text-secondary">@ArtifactDisplay.Size(artifact.SizeBytes)</div>
                                @{
                                    var badge = ArtifactDisplay.SearchBadge(artifact);
                                    var reason = ArtifactDisplay.SearchReason(artifact);
                                }
                                @if (badge is not null)
                                {
                                    <span class="badge text-bg-secondary artifact-search-badge" title="@reason">@badge</span>
                                }
                                @if (reason is not null)
                                {
                                    <span class="@(badge is null ? "small text-secondary artifact-search-reason" : "visually-hidden artifact-search-reason")">@reason</span>
                                }
                            </div>
                            @if (CanChange && _confirmingId != artifact.Id)
                            {
                                <button type="button" id="remove-@artifact.Id" class="btn btn-sm btn-outline-danger d-inline-flex artifact-remove flex-shrink-0"
                                        title="@($"Remove {artifact.FileName}")" aria-label="@($"Remove {artifact.FileName}")"
                                        @onclick="() => _confirmingId = artifact.Id"><Icon Name="delete" /></button>
                            }
                        </div>

                        @if (CanChange && _confirmingId == artifact.Id)
                        {
                            <div class="artifact-confirm" role="group" aria-label="@($"Confirm removing {artifact.FileName}")">
                                <div class="small mb-2 text-break">Remove @artifact.FileName?</div>
                                <button type="button" id="confirm-remove-@artifact.Id" class="btn btn-sm btn-danger" @onclick="() => RemoveAsync(artifact)">Remove</button>
                                <button type="button" id="cancel-remove-@artifact.Id" class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => _confirmingId = null">Cancel</button>
                            </div>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</div>

@code {
    private List<ArtifactDto>? _items;
    private (Guid RecordId, int Key)? _loaded;
    private bool _loadFailed;
    private string? _message;
    private Guid? _confirmingId;

    [Parameter, EditorRequired]
    public Guid RecordId { get; set; }

    [Parameter]
    public bool Editable { get; set; }

    // Set during an override viewing; the token is only sent to the Api and is never rendered.
    [Parameter]
    public Guid? ViewingId { get; set; }

    [Parameter]
    public string? ViewToken { get; set; }

    [Parameter]
    public int RefreshKey { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback OnAccessLost { get; set; }

    private bool CanChange => Editable && ViewingId is null;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == (RecordId, RefreshKey))
        {
            return;
        }

        _loaded = (RecordId, RefreshKey);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadFailed = false;
        _message = null;
        try
        {
            var headers = ViewToken is null ? null : new Dictionary<string, string>(StringComparer.Ordinal) { ["X-View-Token"] = ViewToken };
            var page = await Api.GetAsync<PagedResult<ArtifactDto>>($"api/records/{RecordId}/artifacts?pageSize=100", headers);
            _items = [.. page?.Items ?? []];
        }
        catch (ApiException ex) when (ex.Status == StatusCodes.Status404NotFound && ViewingId is not null)
        {
            _items = [];
            await OnAccessLost.InvokeAsync();
        }
        catch (ApiException)
        {
            _items = null;
            _loadFailed = true;
            _message = "The artifacts could not be loaded. Please try again.";
        }
    }

    private async Task RemoveAsync(ArtifactDto artifact)
    {
        _message = null;
        try
        {
            await Api.SendAsync(HttpMethod.Delete, $"api/artifacts/{artifact.Id}");
        }
        catch (ApiException)
        {
            _message = "The artifact could not be removed. Please try again.";
            _confirmingId = null;
            return;
        }

        _confirmingId = null;
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }
}
