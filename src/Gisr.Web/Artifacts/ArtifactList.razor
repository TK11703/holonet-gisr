@inject ApiClient Api

<div id="artifact-list">
    @if (_message is not null)
    {
        <div class="alert alert-danger" role="alert">@_message</div>
    }

    @if (_items is null)
    {
        @if (!_loadFailed)
        {
            <p class="text-secondary" role="status">Loading...</p>
        }
    }
    else if (_items.Count == 0)
    {
        <p class="text-secondary mb-0">No artifacts attached.</p>
    }
    else
    {
        <ul class="list-unstyled mb-0">
            @foreach (var artifact in _items)
            {
                <li class="artifact-item d-flex gap-3 mb-3" @key="artifact.Id">
                    <div class="artifact-preview flex-shrink-0">
                        @if (artifact.IsImage)
                        {
                            <a class="artifact-open" href="@ArtifactDisplay.MediaUrl(artifact.Id, false, ViewingId)" target="_blank" rel="noopener">
                                <img class="img-thumbnail" src="@ArtifactDisplay.MediaUrl(artifact.Id, true, ViewingId)" alt="@artifact.Description" loading="lazy" width="160" />
                            </a>
                        }
                        else
                        {
                            <span class="d-inline-flex align-items-center justify-content-center border rounded p-3"><Icon Name="file" Size="32" /></span>
                        }
                    </div>
                    <div class="flex-grow-1">
                        <a class="artifact-download" href="@ArtifactDisplay.MediaUrl(artifact.Id, false, ViewingId)" download>@artifact.FileName</a>
                        <div class="small text-secondary">
                            @ArtifactDisplay.Size(artifact.SizeBytes) &middot; @artifact.UploadedByDisplayName &middot; @RecordDisplay.Instant(artifact.UploadedAt)
                        </div>
                        @if (artifact.IsImage && !string.IsNullOrWhiteSpace(artifact.Description) && _editingId != artifact.Id)
                        {
                            <div class="pre-wrap">@artifact.Description</div>
                        }
                        @if (ArtifactDisplay.SearchBadge(artifact) is { } badge)
                        {
                            <span class="badge text-bg-secondary artifact-search-badge">@badge</span>
                        }
                        @if (ArtifactDisplay.SearchReason(artifact) is { } reason)
                        {
                            <span class="small text-secondary artifact-search-reason">@reason</span>
                        }

                        @if (_editingId == artifact.Id)
                        {
                            <div class="mt-2">
                                <label for="description-@artifact.Id" class="form-label small mb-1">Description (used as alt text)</label>
                                <input id="description-@artifact.Id" type="text" class="form-control form-control-sm" maxlength="500" aria-required="true"
                                       value="@_draft" @oninput="e => _draft = e.Value?.ToString() ?? string.Empty" />
                                @if (_editError is not null)
                                {
                                    <div class="small text-danger mt-1" role="alert">@_editError</div>
                                }
                                <div class="mt-2 d-flex gap-2">
                                    <button type="button" id="save-description-@artifact.Id" class="btn btn-sm btn-primary" @onclick="() => SaveDescriptionAsync(artifact)">Save</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                                </div>
                            </div>
                        }

                        @if (CanChange)
                        {
                            @if (_confirmingId == artifact.Id)
                            {
                                <div class="artifact-confirm mt-2" role="group" aria-label="@($"Confirm removing {artifact.FileName}")">
                                    <span>Remove @artifact.FileName?</span>
                                    <button type="button" id="confirm-remove-@artifact.Id" class="btn btn-sm btn-danger ms-2" @onclick="() => RemoveAsync(artifact)">Remove</button>
                                    <button type="button" id="cancel-remove-@artifact.Id" class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => _confirmingId = null">Cancel</button>
                                </div>
                            }
                            else
                            {
                                <div class="mt-2 d-flex gap-2">
                                    @if (artifact.IsImage && _editingId != artifact.Id)
                                    {
                                        <button type="button" id="edit-description-@artifact.Id" class="btn btn-sm btn-outline-secondary artifact-edit"
                                                aria-label="@($"Edit description of {artifact.FileName}")" @onclick="() => BeginEdit(artifact)">Edit description</button>
                                    }
                                    <button type="button" id="remove-@artifact.Id" class="btn btn-sm btn-outline-danger artifact-remove"
                                            aria-label="@($"Remove {artifact.FileName}")" @onclick="() => _confirmingId = artifact.Id">Remove</button>
                                </div>
                            }
                        }
                    </div>
                </li>
            }
        </ul>
    }
</div>

@code {
    private List<ArtifactDto>? _items;
    private (Guid RecordId, int Key)? _loaded;
    private bool _loadFailed;
    private string? _message;
    private Guid? _confirmingId;
    private Guid? _editingId;
    private string _draft = string.Empty;
    private string? _editError;

    [Parameter, EditorRequired]
    public Guid RecordId { get; set; }

    [Parameter]
    public bool Editable { get; set; }

    // Set during an override viewing; the token is only sent to the Api and is never rendered.
    [Parameter]
    public Guid? ViewingId { get; set; }

    [Parameter]
    public string? ViewToken { get; set; }

    [Parameter]
    public int RefreshKey { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback OnAccessLost { get; set; }

    private bool CanChange => Editable && ViewingId is null;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == (RecordId, RefreshKey))
        {
            return;
        }

        _loaded = (RecordId, RefreshKey);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadFailed = false;
        _message = null;
        try
        {
            var headers = ViewToken is null ? null : new Dictionary<string, string>(StringComparer.Ordinal) { ["X-View-Token"] = ViewToken };
            var page = await Api.GetAsync<PagedResult<ArtifactDto>>($"api/records/{RecordId}/artifacts?pageSize=100", headers);
            _items = [.. page?.Items ?? []];
        }
        catch (ApiException ex) when (ex.Status == StatusCodes.Status404NotFound && ViewingId is not null)
        {
            _items = [];
            await OnAccessLost.InvokeAsync();
        }
        catch (ApiException)
        {
            _items = null;
            _loadFailed = true;
            _message = "The artifacts could not be loaded. Please try again.";
        }
    }

    private async Task RemoveAsync(ArtifactDto artifact)
    {
        _message = null;
        try
        {
            await Api.SendAsync(HttpMethod.Delete, $"api/artifacts/{artifact.Id}");
        }
        catch (ApiException)
        {
            _message = "The artifact could not be removed. Please try again.";
            _confirmingId = null;
            return;
        }

        _confirmingId = null;
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    private void BeginEdit(ArtifactDto artifact)
    {
        _editingId = artifact.Id;
        _draft = artifact.Description ?? string.Empty;
        _editError = null;
    }

    private void CancelEdit() => _editingId = null;

    private async Task SaveDescriptionAsync(ArtifactDto artifact)
    {
        if (string.IsNullOrWhiteSpace(_draft))
        {
            _editError = "A description is required.";
            return;
        }

        try
        {
            var updated = await Api.PatchAsync<ArtifactDto>($"api/artifacts/{artifact.Id}", new UpdateArtifactRequest(_draft.Trim()));
            if (updated is not null && _items is not null)
            {
                var index = _items.FindIndex(a => a.Id == artifact.Id);
                if (index >= 0)
                {
                    _items[index] = updated;
                }
            }

            _editingId = null;
        }
        catch (ApiException ex)
        {
            _editError = ex.Errors.Values.SelectMany(v => v).FirstOrDefault() ?? "The description could not be saved.";
        }
    }
}
