@page "/records/new"
@inject ApiClient Api
@inject CurrentUserState User
@inject NavigationManager Navigation

<PageHeader Title="New record" Crumbs="Crumbs" />

@if (_loadError)
{
    <div class="alert alert-danger" role="alert">The form could not be loaded. Please try again.</div>
}
else if (_model is null)
{
    <p class="text-secondary" role="status">Loading...</p>
}
else
{
    <RecordForm Model="_model" Affiliations="_affiliations" OnSave="SaveAsync" CancelHref="/records"
                ShowCitizenPicker="User.IsOfficer" AllowSealing="User.IsOfficer"
                OnSubjectChanged="SubjectChangedAsync" AffiliationOwner="@(_model.SubjectObjectId is null ? null : _model.SubjectDisplayName)"
                AffiliationsLoading="_loadingAffiliations" AffiliationsFailed="_affiliationsFailed" />
}

@code {
    private static readonly Crumb[] Crumbs = [new("Citizen records", "/records"), new("New record")];

    private IReadOnlyList<AccountAffiliationDto> _affiliations = [];
    private IReadOnlyList<AccountAffiliationDto> _mine = [];
    private RecordFormModel? _model;
    private bool _loadError;
    private bool _loadingAffiliations;
    private bool _affiliationsFailed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _mine = _affiliations = await Api.GetAsync<List<AccountAffiliationDto>>("api/me/affiliations") ?? [];
            _model = RecordFormModel.New(RecordDisplay.AffiliationLabels(_affiliations).FirstOrDefault() ?? string.Empty);
            await LoadUserAsync();
        }
        catch (ApiException)
        {
            _loadError = true;
        }
    }

    private async Task LoadUserAsync()
    {
        try
        {
            await User.EnsureLoadedAsync();
        }
        catch (ApiException)
        {
            // Without the account the Officer-only citizen picker stays hidden; the Api enforces access either way.
        }
    }

    // The record's affiliation must come from the citizen it is about, so reload the list whenever the citizen changes.
    private async Task SubjectChangedAsync()
    {
        var subject = _model!.SubjectObjectId;
        _affiliationsFailed = false;
        if (_model.NeedsCitizen)
        {
            _loadingAffiliations = false;
            _affiliations = [];
            _model.Affiliation = string.Empty;
            return;
        }

        IReadOnlyList<AccountAffiliationDto> loaded = _mine;
        if (subject is not null)
        {
            _loadingAffiliations = true;
            _affiliations = [];
            _model.Affiliation = string.Empty;
            try
            {
                loaded = await Api.GetAsync<List<AccountAffiliationDto>>($"api/accounts/by-object/{subject}/affiliations") ?? [];
            }
            catch (ApiException)
            {
                loaded = [];
                _affiliationsFailed = true;
            }

            if (_model.SubjectObjectId != subject)
            {
                return;
            }
        }

        _loadingAffiliations = false;
        _affiliations = loaded;
        _model.Affiliation = RecordDisplay.AffiliationLabels(loaded).FirstOrDefault() ?? string.Empty;
    }

    private async Task SaveAsync(RecordFormModel model)
    {
        var created = await Api.PostAsync<RecordDto>("api/records", model.ToCreateRequest());
        // Incidents, awards, and artifacts unlock once the record exists, so continue on its edit page.
        Navigation.NavigateTo($"/records/{created!.Id}/edit");
    }
}
