@page "/records/{Id:guid}/edit"
@inject ApiClient Api
@inject CurrentUserState User
@inject NavigationManager Navigation

<PageHeader Title="Edit record" Crumbs="Crumbs" />

@if (_notFound)
{
    <div class="alert alert-warning" role="alert">Record not found.</div>
}
else if (_loadError)
{
    <div class="alert alert-danger" role="alert">The record could not be loaded. Please try again.</div>
}
else if (_model is null)
{
    <p class="text-secondary" role="status">Loading...</p>
}
else if (!_canEdit)
{
    <div class="alert alert-warning" role="alert">You are not permitted to edit this record.</div>
}
else
{
    <RecordForm Model="_model" Affiliations="_affiliations" OnSave="SaveAsync" OnDelete="DeleteAsync" OnReload="ReloadAsync"
                CancelHref="@($"/records/{Id}")" AllowSealing="User.IsOfficer"
                AffiliationOwner="@_affiliationOwner" AffiliationsFailed="_affiliationsFailed"
                SubjectName="@_subjectName" SubjectOperatingNumber="@_subjectNumber" />
}

@code {
    private Crumb[] Crumbs => [new("Citizen records", "/records"), new("Record", $"/records/{Id}"), new("Edit")];

    private IReadOnlyList<AccountAffiliationDto> _affiliations = [];
    private RecordFormModel? _model;
    private Guid _loadedId;
    private bool _canEdit;
    private bool _notFound;
    private bool _loadError;
    private bool _affiliationsFailed;
    private string? _affiliationOwner;
    private string? _subjectName;
    private string? _subjectNumber;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _model = null;
        _notFound = false;
        _loadError = false;
        try
        {
            await LoadUserAsync();
            await LoadRecordAsync();
        }
        catch (ApiException ex) when (ex.Status == 404)
        {
            _notFound = true;
        }
        catch (ApiException)
        {
            _loadError = true;
        }
    }

    private async Task LoadUserAsync()
    {
        try
        {
            await User.EnsureLoadedAsync();
        }
        catch (ApiException)
        {
            // Without the account the Officer-only seal controls stay hidden; the Api enforces access either way.
        }
    }

    private async Task LoadRecordAsync()
    {
        var record = await Api.GetAsync<RecordDto>($"api/records/{Id}");
        _canEdit = record!.CanEdit;
        _model = RecordFormModel.FromDto(record);
        _subjectName = record.SubjectDisplayName;
        _subjectNumber = record.SubjectOperatingNumber;
        await LoadAffiliationsAsync(record);
    }

    // The affiliation choices belong to the citizen the record is about; Officers read other citizens' lists.
    private async Task LoadAffiliationsAsync(RecordDto record)
    {
        var own = User.Account is { } account && account.Id == record.SubjectAccountId;
        _affiliationOwner = own || !User.IsOfficer ? null : record.SubjectDisplayName;
        _affiliationsFailed = false;
        try
        {
            var path = User.IsOfficer ? $"api/accounts/{record.SubjectAccountId}/affiliations" : "api/me/affiliations";
            _affiliations = await Api.GetAsync<List<AccountAffiliationDto>>(path) ?? [];
        }
        catch (ApiException)
        {
            _affiliations = [];
            _affiliationsFailed = true;
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            await LoadRecordAsync();
        }
        catch (ApiException)
        {
            _loadError = true;
        }
    }

    private async Task SaveAsync(RecordFormModel model)
    {
        await Api.PutAsync<RecordDto>($"api/records/{Id}", model.ToUpdateRequest());
        Navigation.NavigateTo($"/records/{Id}");
    }

    private async Task DeleteAsync()
    {
        await Api.SendAsync(HttpMethod.Delete, $"api/records/{Id}");
        Navigation.NavigateTo("/records");
    }
}
