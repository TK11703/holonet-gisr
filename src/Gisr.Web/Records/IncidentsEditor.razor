@if (CanChange)
{
    <fieldset id="new-incident" class="border rounded px-3 pb-3 mb-4">
        <legend class="float-none w-auto px-2 h6 mb-3">New incident</legend>
        <div class="row g-3">
            <div class="col-md-9">
                <div class="form-floating">
                    <input id="new-incident-title" type="text" class="@(_titleError is null ? "form-control" : "form-control is-invalid")" maxlength="200" placeholder="Title"
                           title="Required. A short name for the incident, up to 200 characters."
                           aria-required="true" aria-invalid="@(_titleError is null ? null : "true")" aria-describedby="@(_titleError is null ? null : "new-incident-title-error")"
                           @bind="_draft.Title" />
                    <label for="new-incident-title">Title <span class="text-danger" aria-hidden="true">*</span></label>
                </div>
                @if (_titleError is not null)
                {
                    <div id="new-incident-title-error" class="invalid-feedback d-block">@_titleError</div>
                }
            </div>
            <div class="col-md-3">
                <div class="form-floating">
                    <input id="new-incident-date" type="date" class="@(_dateError is null ? "form-control" : "form-control is-invalid")" placeholder="Date"
                           title="Required. The date the incident occurred."
                           aria-required="true" aria-invalid="@(_dateError is null ? null : "true")" aria-describedby="@(_dateError is null ? null : "new-incident-date-error")"
                           @bind="_draft.OccurredOn" @bind:format="yyyy-MM-dd" />
                    <label for="new-incident-date">Date <span class="text-danger" aria-hidden="true">*</span></label>
                </div>
                @if (_dateError is not null)
                {
                    <div id="new-incident-date-error" class="invalid-feedback d-block">@_dateError</div>
                }
            </div>
            <div class="col-12">
                <div class="form-floating">
                    <textarea id="new-incident-description" class="form-control" rows="3" maxlength="4000" placeholder="Description"
                              title="Optional. What happened, up to 4000 characters." @bind="_draft.Description"></textarea>
                    <label for="new-incident-description">Description</label>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <button type="button" id="add-incident" class="btn btn-primary d-inline-flex align-items-center gap-2"
                    disabled="@(Items.Count >= RecordFormModel.MaxItems)" @onclick="Add"><Icon Name="plus" /> Add incident</button>
        </div>
    </fieldset>
}

<section aria-labelledby="added-incidents-heading">
    <h3 id="added-incidents-heading" class="h6">Record incidents</h3>
    @if (RecordDisplay.ErrorText(Errors, "incidents") is { } listError)
    {
        <div id="incidents-error" class="invalid-feedback d-block mb-2">@listError</div>
    }

    @if (Items.Count == 0)
    {
        <div id="incidents-empty" class="alert alert-info d-flex align-items-start gap-2 mb-0" role="status">
            <span class="flex-shrink-0"><Icon Name="info" /></span>
            <span>No incidents added yet.</span>
        </div>
    }
    else
    {
        <ul id="incident-list" class="list-group">
            @for (var i = 0; i < Items.Count; i++)
            {
                var index = i;
                var item = Items[i];
                var itemError = RecordDisplay.ErrorText(Errors, $"incidents[{index}].title")
                    ?? RecordDisplay.ErrorText(Errors, $"incidents[{index}].occurredOn")
                    ?? RecordDisplay.ErrorText(Errors, $"incidents[{index}].description");

                <li class="list-group-item" id="@($"incident-{index}")" @key="item">
                    <div class="d-flex w-100 justify-content-between align-items-start gap-3">
                        <div class="min-w-0">
                            <h4 class="h6 mb-1 text-break">@item.Title</h4>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p class="mb-1 pre-wrap text-break">@item.Description</p>
                            }
                            @if (itemError is not null)
                            {
                                <div class="invalid-feedback d-block">@itemError</div>
                            }
                        </div>
                        <div class="d-flex flex-column align-items-end gap-2 flex-shrink-0">
                            @if (item.OccurredOn is { } date)
                            {
                                <time class="small text-secondary text-nowrap" datetime="@RecordDisplay.Date(date)">@RecordDisplay.Date(date)</time>
                            }
                            @if (CanChange)
                            {
                                <button type="button" class="btn btn-outline-danger border-0 btn-sm d-inline-flex" title="Remove this incident"
                                        aria-label="@($"Remove incident {index + 1}")" @onclick="@(() => Items.Remove(item))"><Icon Name="delete" /></button>
                            }
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
</section>

@code {
    private IncidentModel _draft = new();
    private string? _dateError;
    private string? _titleError;

    [Parameter, EditorRequired]
    public List<IncidentModel> Items { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<string, string[]> Errors { get; set; } = new Dictionary<string, string[]>();

    // Only Officers add or remove incidents; everyone else sees the permanent list.
    [Parameter]
    public bool CanChange { get; set; }

    private void Add()
    {
        _dateError = _draft.OccurredOn is null ? "Enter the date of the incident." : null;
        _titleError = string.IsNullOrWhiteSpace(_draft.Title) ? "Enter a title." : null;
        if (_dateError is not null || _titleError is not null)
        {
            return;
        }

        Items.Add(_draft);
        _draft = new IncidentModel();
    }
}
