@inject ApiClient Api

<fieldset id="citizen-picker" class="mb-3">
    <legend class="visually-hidden">Who is this record for?</legend>
    <div class="d-flex flex-wrap align-items-start gap-3">
    <div class="btn-group segmented-choice flex-shrink-0" role="group" aria-label="Who is this record for?">
        <input type="radio" class="btn-check" name="citizen-for" id="citizen-for-myself" autocomplete="off"
               checked="@(!Model.ForAnother)" @onchange="UseMyself" />
        <label class="btn d-inline-flex align-items-center gap-2" for="citizen-for-myself"><Icon Name="user" /> For myself</label>
        <input type="radio" class="btn-check" name="citizen-for" id="citizen-for-other" autocomplete="off"
               checked="@Model.ForAnother" @onchange="UseAnother" />
        <label class="btn d-inline-flex align-items-center gap-2" for="citizen-for-other"><Icon Name="search" /> For someone else</label>
    </div>

    @if (Model.ForAnother && Model.SubjectObjectId is not null)
    {
        <div class="input-group flex-grow-1" style="flex-basis: 16rem;">
            <span class="input-group-text"><Icon Name="user" /></span>
            <input id="citizen-selected" type="text" class="form-control" readonly aria-label="Selected citizen" value="@Model.SubjectDisplayName" />
            <button type="button" id="citizen-change" class="btn btn-outline-secondary" @onclick="Change">Change</button>
        </div>
    }
    else if (Model.ForAnother)
    {
        <div class="flex-grow-1 position-relative" style="flex-basis: 16rem;">
            <label for="citizen-search" class="visually-hidden">Search the tenant directory</label>
            <input id="citizen-search" type="search" class="form-control" autocomplete="off" maxlength="100"
                   placeholder="Search for the citizen by name, email, or operating number..."
                   value="@_query" @oninput="OnInputAsync" @onkeydown="OnKeyDown" />
            @if (_results.Count > 0)
            {
                <ul class="list-group position-absolute start-0 end-0 mt-1 shadow z-3 overflow-auto" style="max-height: 20rem;">
                    @foreach (var account in _results)
                    {
                        <li class="list-group-item p-0">
                            <button type="button" class="list-group-item list-group-item-action border-0 citizen-option" @onclick="() => Select(account)"><span>@account.DisplayName</span>
                                @if (account.Email is not null)
                                {
                                    <small class="d-block text-secondary">@account.Email</small>
                                }
                            </button>
                        </li>
                    }
                </ul>
            }
            @if (_status is not null)
            {
                <div id="citizen-results-status" class="list-group position-absolute start-0 end-0 mt-1 shadow z-3" role="status">
                    <div class="list-group-item small text-secondary">@_status</div>
                </div>
            }
        </div>
    }
    </div>
</fieldset>

@code {
    private const int MinQueryLength = 2;

    private IReadOnlyList<DirectoryUserDto> _results = [];
    private string _query = string.Empty;
    private string? _status;

    [Parameter, EditorRequired]
    public RecordFormModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        var query = e.Value?.ToString()?.Trim() ?? string.Empty;
        _query = query;
        if (query.Length < MinQueryLength)
        {
            _results = [];
            _status = null;
            return;
        }

        try
        {
            var found = await Api.GetAsync<List<DirectoryUserDto>>($"api/accounts?query={Uri.EscapeDataString(query)}&pageSize=10") ?? [];
            if (query != _query)
            {
                return;
            }

            _results = found;
            _status = found.Count == 0 ? "No matching citizens." : null;
        }
        catch (ApiException)
        {
            _results = [];
            _status = "The citizen search is unavailable.";
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _results = [];
            _status = null;
        }
    }

    private Task Select(DirectoryUserDto account)
    {
        Model.SubjectObjectId = account.ObjectId;
        Model.SubjectDisplayName = account.DisplayName;
        ClearSearch();
        return OnChanged.InvokeAsync();
    }

    private Task UseAnother()
    {
        Model.ForAnother = true;
        return OnChanged.InvokeAsync();
    }

    private Task UseMyself()
    {
        Model.ForAnother = false;
        return Clear();
    }

    private Task Change() => Clear();

    private Task Clear()
    {
        Model.SubjectObjectId = null;
        Model.SubjectDisplayName = null;
        ClearSearch();
        return OnChanged.InvokeAsync();
    }

    private void ClearSearch()
    {
        _results = [];
        _query = string.Empty;
        _status = null;
    }
}
