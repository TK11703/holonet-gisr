@page "/records/{Id:guid}"
@implements IAsyncDisposable
@implements IDisposable
@inject ApiClient Api
@inject ViewGrantStore Grants
@inject NavigationManager Navigation

<PageHeader Title="Record item" Crumbs="Crumbs" />

@if (_notFound)
{
    <div class="alert alert-warning" role="alert">Record not found.</div>
}
else if (_loadError)
{
    <div class="alert alert-danger" role="alert">The record could not be loaded. Please try again.</div>
}
else if (_record is null && _locked)
{
    <div class="alert alert-danger" role="alert">Access denied. This record is sealed.</div>
    <form id="override-form" class="card card-body mb-4" @onsubmit="UnlockAsync" novalidate>
        <label for="override-code" class="form-label">Override code</label>
        <div class="d-flex flex-wrap gap-2">
            <input id="override-code" type="password" autocomplete="off" maxlength="64"
                   class="@(_overrideError is null ? "form-control w-auto" : "form-control w-auto is-invalid")"
                   aria-invalid="@(_overrideError is null ? null : "true")"
                   aria-describedby="@(_overrideError is null ? null : "override-error")"
                   disabled="@_lockedOut" value="@_code" @oninput="OnCodeInput" />
            <button type="submit" class="btn btn-primary" disabled="@(_lockedOut || _submitting)">Unlock</button>
        </div>
        @if (_overrideError is not null)
        {
            <div id="override-error" class="invalid-feedback d-block" role="alert">@_overrideError</div>
        }
    </form>
}
else if (_record is null)
{
    <p class="text-secondary" role="status">Loading...</p>
}
else
{
    var record = _record;
    var viewing = _viewingId is not null;

    if (viewing)
    {
        <div id="override-banner" class="alert alert-warning mb-3" role="status">
            <div class="d-flex align-items-center gap-2">
                <Icon Name="lock" /> <span>Viewing under override. Access ends when you leave this page.</span>
            </div>
            @if (_unsealFailed)
            {
                <div id="unseal-failed" class="text-danger mt-2" role="alert">The record could not be unsealed. Please try again.</div>
            }
            @if (_confirmingUnseal)
            {
                <div id="unseal-confirmation" class="mt-2">
                    <p class="mb-2">Unseal this record for good? Anyone who can read it will see it again.</p>
                    <button type="button" id="confirm-unseal" class="btn btn-sm btn-warning me-2" disabled="@_unsealing" @onclick="UnsealAsync">Unseal record</button>
                    <button type="button" id="cancel-unseal" class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmingUnseal = false">Keep sealed</button>
                </div>
            }
            else
            {
                <button type="button" id="unseal-record" class="btn btn-sm btn-outline-dark mt-2" @onclick="() => _confirmingUnseal = true">Unseal record</button>
            }
        </div>
        <span id="viewing-id" hidden data-viewing-id="@_viewingId"></span>
    }

    @if (_deleteFailed)
    {
        <div id="delete-failed" class="alert alert-danger" role="alert">The record could not be deleted. Please try again.</div>
    }
    @if (_confirmingDelete)
    {
        <div id="delete-confirmation" class="alert alert-danger mb-3" role="alert">
            <p class="mb-2">Delete this record? It will no longer appear in lists, search, or the gallery.</p>
            <button type="button" id="confirm-delete-record" class="btn btn-danger btn-sm d-inline-flex align-items-center gap-2 me-2" disabled="@_deleting" @onclick="DeleteAsync">
                <Icon Name="delete" /> Delete permanently
            </button>
            <button type="button" id="cancel-delete-record" class="btn btn-outline-secondary btn-sm" disabled="@_deleting" @onclick="() => _confirmingDelete = false">Keep record</button>
        </div>
    }

    <div class="position-relative mb-4">
    <fieldset id="record-header" class="card card-accent">
        <legend class="float-none w-auto px-2 ms-3 mb-0 h6">Record details</legend>
        <div class="@(record.CanEdit && !viewing ? "card-body pe-6" : "card-body")">
            <dl class="row gy-3 mb-0">
                <div class="col-md-4">
                    <dt>Subject</dt>
                    <dd class="mb-0">@record.SubjectDisplayName</dd>
                </div>
                <div class="col-md-4">
                    <dt>Affiliation</dt>
                    <dd class="mb-0">@record.Affiliation</dd>
                </div>
                <div class="col-md-4">
                    <dt>Engagement period</dt>
                    <dd id="engagement-period" class="mb-0">
                        @if (record.EngagementStart is null && record.EngagementEnd is null)
                        {
                            <span class="text-secondary">Dates were not provided.</span>
                        }
                        else
                        {
                            @RecordDisplay.Engagement(record.EngagementStart, record.EngagementEnd)
                        }
                    </dd>
                </div>
                <div class="col-md-4">
                    <dt>Author</dt>
                    <dd class="mb-0">@record.AuthorDisplayName</dd>
                </div>
                <div class="col-md-4">
                    <dt>Revision</dt>
                    <dd class="mb-0">Version @record.Version, updated @RecordDisplay.Instant(record.UpdatedAt)</dd>
                </div>
                @if (record.IsSealed)
                {
                    <div class="col-md-4 d-flex align-items-center">
                        <span id="sealed-indicator" class="text-warning-emphasis" title="Sealed record: its subject must enter an override code to view it."><Icon Name="lock" Size="20" Label="Sealed" /></span>
                    </div>
                }
            </dl>
        </div>
    </fieldset>
    @if (record.CanEdit && !viewing)
    {
        <div class="card-side-action position-absolute bottom-0 end-0 d-flex align-items-center px-2">
            <RecordActionsMenu RecordId="record.Id" OnDelete="() => { _deleteFailed = false; _confirmingDelete = true; }" />
        </div>
    }
    </div>

    @if (record.EngagementDetail.TryGetValue(EngagementSummary.Key, out var summary) && summary.Length > 0)
    {
        <fieldset id="engagement-summary" class="card card-accent mb-4">
            <legend class="float-none w-auto px-2 ms-3 mb-0 h6">Summary</legend>
            <div class="card-body">
                <p class="pre-wrap mb-0">@summary</p>
            </div>
        </fieldset>
    }

    <div class="accordion mb-4">
        <AccordionItem Id="incidents" Title="Incidents" Count="record.Incidents.Count">
            @if (record.Incidents.Count == 0)
            {
                <EmptyNotice Id="incidents-empty">No incidents recorded.</EmptyNotice>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var incident in record.Incidents)
                    {
                        <li class="mb-3">
                            <div><strong>@incident.Title</strong> <span class="text-secondary">@RecordDisplay.Date(incident.OccurredOn)</span></div>
                            @if (!string.IsNullOrWhiteSpace(incident.Description))
                            {
                                <div class="pre-wrap">@incident.Description</div>
                            }
                        </li>
                    }
                </ul>
            }
        </AccordionItem>

        <AccordionItem Id="awards" Title="Awards" Count="record.Awards.Count">
            @if (record.Awards.Count == 0)
            {
                <EmptyNotice Id="awards-empty">No awards recorded.</EmptyNotice>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var award in record.Awards)
                    {
                        <li class="mb-3">
                            <div>
                                <strong>@award.Name</strong>
                                <span class="text-secondary">@RecordDisplay.Date(award.AwardedOn)</span>
                                @if (!string.IsNullOrWhiteSpace(award.Issuer))
                                {
                                    <span class="text-secondary">&middot; @award.Issuer</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(award.Description))
                            {
                                <div class="pre-wrap">@award.Description</div>
                            }
                        </li>
                    }
                </ul>
            }
        </AccordionItem>

        <AccordionItem Id="artifacts" Title="Artifacts" Count="_artifactCount">
            <ArtifactList RecordId="record.Id" ViewingId="_viewingId" ViewToken="@ViewToken" OnAccessLost="OnArtifactAccessLost" OnCountChanged="count => _artifactCount = count" />
        </AccordionItem>

        @if (!viewing)
        {
            <AccordionItem Id="history" Title="History" Count="(int)_historyTotal">
                @if (_history.Count == 0)
                {
                    <EmptyNotice Id="history-empty">No revisions recorded.</EmptyNotice>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Version</th>
                                    <th scope="col">Changed by</th>
                                    <th scope="col">Changed</th>
                                    <th scope="col">Title</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var revision in _history)
                                {
                                    <tr>
                                        <td>@revision.Version</td>
                                        <td>@revision.ChangedByDisplayName</td>
                                        <td>@RecordDisplay.Instant(revision.ChangedAt)</td>
                                        <td>@revision.Title</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (_history.Count < _historyTotal)
                {
                    <button type="button" id="more-history" class="btn btn-outline-secondary btn-sm mt-3" @onclick="LoadMoreHistoryAsync">Show older revisions</button>
                }
            </AccordionItem>
        }
    </div>
}

@code {
    private const int HistoryPageSize = 20;

    private Crumb[] Crumbs => [new("Citizen records", "/records"), new(_record?.Title ?? "Record")];

    private RecordDto? _record;
    private List<RevisionDto> _history = [];
    private long _historyTotal;
    private int _historyPage;
    private int _artifactCount;
    private Guid _loadedId;
    private bool _notFound;
    private bool _loadError;
    private bool _locked;
    private bool _lockedOut;
    private bool _submitting;
    private bool _unsealing;
    private bool _unsealFailed;
    private bool _confirmingUnseal;
    private bool _confirmingDelete;
    private bool _deleting;
    private bool _deleteFailed;
    private bool _disposed;
    private string _code = string.Empty;
    private string? _overrideError;
    private string _userKey = ViewGrantStore.UserKey(null);
    private Guid? _viewingId;
    private CancellationTokenSource? _pollCts;

    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public TimeSpan PollInterval { get; set; } = TimeSpan.FromSeconds(20);

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        await RevokeViewingAsync();
        _loadedId = Id;
        _record = null;
        _history = [];
        _historyPage = 0;
        _artifactCount = 0;
        _notFound = false;
        _loadError = false;
        _locked = false;
        _lockedOut = false;
        _overrideError = null;
        _code = string.Empty;
        try
        {
            _record = await Api.GetAsync<RecordDto>($"api/records/{Id}");
            await LoadMoreHistoryAsync();
        }
        catch (ApiException ex) when (ex.Status == 403 && ex.IsSealed)
        {
            _record = null;
            _locked = true;
        }
        catch (ApiException ex) when (ex.Status == 404)
        {
            _record = null;
            _notFound = true;
        }
        catch (ApiException)
        {
            _record = null;
            _loadError = true;
        }
    }

    private async Task LoadMoreHistoryAsync()
    {
        var next = _historyPage + 1;
        var page = await Api.GetAsync<PagedResult<RevisionDto>>($"api/records/{Id}/history?page={next}&pageSize={HistoryPageSize}");
        if (page is not null)
        {
            _history = [.. _history, .. page.Items];
            _historyTotal = page.TotalCount;
            _historyPage = next;
        }
    }

    private async Task DeleteAsync()
    {
        if (_deleting)
        {
            return;
        }

        _deleting = true;
        _deleteFailed = false;
        try
        {
            await Api.SendAsync(HttpMethod.Delete, $"api/records/{Id}");
            Navigation.NavigateTo("/records");
        }
        catch (ApiException)
        {
            _confirmingDelete = false;
            _deleteFailed = true;
        }
        finally
        {
            _deleting = false;
        }
    }

    private void OnCodeInput(ChangeEventArgs e) => _code = e.Value?.ToString() ?? string.Empty;

    // The token never leaves the server; ArtifactList only sends it to the Api.
    private string? ViewToken => _viewingId is { } viewingId && Grants.TryGet(_userKey, viewingId, out var entry) ? entry.Token : null;

    private void OnArtifactAccessLost()
    {
        if (_viewingId is { } viewingId)
        {
            EndViewing(viewingId);
        }
    }

    private async Task UnlockAsync()
    {
        if (_lockedOut || _submitting)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_code))
        {
            _overrideError = "Enter the override code.";
            return;
        }

        _submitting = true;
        _overrideError = null;
        try
        {
            var unlocked = await Api.PostAsync<UnlockedRecordDto>($"api/records/{Id}/override", new OverrideCodeRequest(_code));
            if (unlocked is null)
            {
                _overrideError = "The override code could not be checked. Please try again.";
            }
            else
            {
                await StartViewingAsync(unlocked);
            }
        }
        catch (ApiException ex) when (ex.Status == 403)
        {
            _overrideError = ex.Extensions.TryGetValue("attemptsRemaining", out var remaining) && remaining.TryGetInt32(out var count)
                ? $"Incorrect override code. {count} {(count == 1 ? "attempt" : "attempts")} remaining."
                : "Incorrect override code.";
        }
        catch (ApiException ex) when (ex.Status == 429)
        {
            var minutes = (int)Math.Ceiling((ex.RetryAfter ?? TimeSpan.FromMinutes(15)).TotalMinutes);
            _lockedOut = true;
            _overrideError = $"Too many attempts. Try again in {minutes} {(minutes == 1 ? "minute" : "minutes")}.";
        }
        catch (ApiException ex) when (ex.Status == 404)
        {
            _locked = false;
            _notFound = true;
        }
        catch (ApiException)
        {
            _overrideError = "The override code could not be checked. Please try again.";
        }
        finally
        {
            _submitting = false;
            _code = string.Empty;
        }
    }

    private async Task StartViewingAsync(UnlockedRecordDto unlocked)
    {
        _confirmingUnseal = false;
        _unsealFailed = false;
        var state = AuthState is null ? null : await AuthState;
        _userKey = ViewGrantStore.UserKey(state?.User);
        _viewingId = Grants.Register(_userKey, Id, unlocked.ViewToken);
        _record = unlocked.Record;
        _locked = false;
        _pollCts = new CancellationTokenSource();
        _ = PollAsync(_viewingId.Value, _pollCts.Token);
    }

    // The view token stays on the server; the poll only learns whether the grant is still valid.
    private async Task PollAsync(Guid viewingId, CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(PollInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (!Grants.TryGet(_userKey, viewingId, out var entry))
                {
                    return;
                }

                try
                {
                    await Api.SendAsync(HttpMethod.Get, $"api/records/{entry.RecordId}/override/status", null, TokenHeader(entry.Token), cancellationToken);
                }
                catch (ApiException ex) when (ex.Status == 404)
                {
                    await InvokeAsync(() => EndViewing(viewingId));
                    return;
                }
                catch (ApiException)
                {
                    // Transient failures never end a viewing; the next tick tries again.
                }
                catch (HttpRequestException)
                {
                }
                catch (OperationCanceledException) when (!cancellationToken.IsCancellationRequested)
                {
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    // The grant proves the subject knows the code; once the seal is lifted the page reloads as an ordinary record.
    private async Task UnsealAsync()
    {
        if (_unsealing || _viewingId is not { } viewingId || !Grants.TryGet(_userKey, viewingId, out var entry))
        {
            return;
        }

        _unsealing = true;
        _unsealFailed = false;
        try
        {
            await Api.SendAsync(HttpMethod.Post, $"api/records/{entry.RecordId}/unseal", null, TokenHeader(entry.Token));
            StopPolling();
            Grants.Remove(_userKey, viewingId);
            _viewingId = null;
            _confirmingUnseal = false;
            _loadedId = Guid.Empty;
            await OnParametersSetAsync();
        }
        catch (ApiException)
        {
            _unsealFailed = true;
        }
        finally
        {
            _unsealing = false;
        }
    }

    private void EndViewing(Guid viewingId)
    {
        if (_disposed || _viewingId != viewingId)
        {
            return;
        }

        StopPolling();
        Grants.Remove(_userKey, viewingId);
        _viewingId = null;
        _record = null;
        _locked = true;
        _overrideError = null;
        StateHasChanged();
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;
    }

    private async Task RevokeViewingAsync()
    {
        StopPolling();
        if (_viewingId is not { } viewingId)
        {
            return;
        }

        _viewingId = null;
        try
        {
            if (Grants.TryGet(_userKey, viewingId, out var entry))
            {
                await Api.SendAsync(HttpMethod.Delete, $"api/records/{entry.RecordId}/override", null, TokenHeader(entry.Token));
            }
        }
        catch (ApiException)
        {
            // Best effort: the grant also expires on its own and is purged server-side.
        }
        catch (HttpRequestException)
        {
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            Grants.Remove(_userKey, viewingId);
        }
    }

    private static Dictionary<string, string> TokenHeader(string token) => new(StringComparer.Ordinal) { ["X-View-Token"] = token };

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        await RevokeViewingAsync();
    }

    void IDisposable.Dispose() => StopPolling();
}
