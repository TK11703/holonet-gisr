@implements IDisposable
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject ShellInterop Shell

<div class="record-actions position-relative" @onkeydown="OnKeyDown">
    <button type="button" id="record-actions-button" class="btn btn-icon" @ref="_trigger" aria-label="Record actions"
            aria-haspopup="menu" aria-expanded="@(_open ? "true" : "false")" aria-controls="record-actions-menu"
            @onclick="Toggle" @onkeydown="OnTriggerKeyDown">
        <Icon Name="more" Size="20" />
    </button>

    @if (_open)
    {
        <div class="menu-backdrop" @onclick="Close"></div>
        <ul id="record-actions-menu" class="dropdown-menu dropdown-menu-end end-0 show" role="menu"
            aria-labelledby="record-actions-button" @ref="_menu">
            <li>
                <a id="edit-record" class="dropdown-item d-flex align-items-center gap-2" role="menuitem" href="/records/@RecordId/edit">
                    <Icon Name="edit" /> Edit
                </a>
            </li>
            <li>
                <button type="button" id="delete-record" class="dropdown-item d-flex align-items-center gap-2 text-danger" role="menuitem"
                        @onclick="DeleteAsync">
                    <Icon Name="delete" /> Delete
                </button>
            </li>
        </ul>
    }
</div>

@code {
    private ElementReference _trigger;
    private ElementReference _menu;
    private IAsyncDisposable? _trap;
    private bool _open;
    private bool _wasOpen;

    [Parameter, EditorRequired]
    public Guid RecordId { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(() =>
        {
            if (_open)
            {
                _open = false;
                StateHasChanged();
            }
        });

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    private void OnTriggerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown")
        {
            _open = true;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _open)
        {
            Close();
            await _trigger.FocusAsync();
        }
    }

    private async Task DeleteAsync()
    {
        Close();
        await OnDelete.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_open && !_wasOpen)
        {
            _trap = await Shell.TrapFocusAsync(_menu, async () =>
            {
                await InvokeAsync(() =>
                {
                    _open = false;
                    StateHasChanged();
                });
            });
        }
        else if (!_open && _wasOpen && _trap is not null)
        {
            await _trap.DisposeAsync();
            _trap = null;
        }

        _wasOpen = _open;
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    public async ValueTask DisposeAsync()
    {
        if (_trap is not null)
        {
            await _trap.DisposeAsync();
        }
    }
}
