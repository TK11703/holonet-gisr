@page "/records"
@inject ApiClient Api
@inject CurrentUserState User

<PageHeader Title="Citizen records" Crumbs="Crumbs" />

@if (!_loadError && _page is not null && (User.IsOfficer || _page.TotalCount > 0 || _affiliation.Length > 0))
{
    <div class="d-flex flex-wrap gap-3 align-items-end mb-3">
        @if (User.IsOfficer)
        {
            <div>
                <label for="filter-scope" class="form-label">Records</label>
                <select id="filter-scope" class="form-select" value="@(_allScope ? "all" : "mine")"
                        @onchange="OnScopeChanged">
                    <option value="mine">My records</option>
                    <option value="all">All records</option>
                </select>
            </div>
        }
        <div>
            <label for="filter-affiliation" class="form-label">Affiliation</label>
            <select id="filter-affiliation" class="form-select" value="@_affiliation" @onchange="OnAffiliationChanged">
                <option value="">All affiliations</option>
                @foreach (var affiliation in _affiliations)
                {
                    <option value="@affiliation.Code">@affiliation.Name</option>
                }
            </select>
        </div>
        <div>
            <label for="sort" class="form-label">Sort by</label>
            <select id="sort" class="form-select" value="@_sort" @onchange="OnSortChanged">
                @foreach (var (value, label) in SortOptions)
                {
                    <option value="@value">@label</option>
                }
            </select>
        </div>
        <a class="btn btn-primary ms-auto" href="/records/new">New record</a>
    </div>
}

@if (_loadError)
{
    <div class="alert alert-danger" role="alert">Your records could not be loaded. Please try again.</div>
}
else if (_page is null)
{
    <p class="text-secondary" role="status">Loading...</p>
}
else if (_page.TotalCount == 0 && _affiliation.Length == 0 && !_allScope)
{
    <section class="card">
        <div class="card-body">
            <h2 class="h5">You have no citizen records yet</h2>
            <p class="text-secondary">Create your first citizen record to document an engagement under an affiliation.</p>
            <a class="btn btn-primary" href="/records/new">Create your first record</a>
        </div>
    </section>
}
else
{
    @if (_subjectId is not null)
    {
        <p id="subject-filter" class="mb-3">
            <span class="badge text-bg-secondary">Subject: @_subjectName</span>
            <button type="button" id="clear-subject" class="btn btn-sm btn-outline-secondary ms-2" @onclick="ClearSubjectAsync">Clear subject filter</button>
        </p>
    }

    @if (_page.TotalCount == 0)
    {
        <p class="text-secondary" role="status">No records match this filter.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">Title</th>
                        <th scope="col">Affiliation</th>
                        <th scope="col">Subject</th>
                        <th scope="col">Engagement</th>
                        <th scope="col">Artifacts</th>
                        <th scope="col">Updated</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in _page.Items)
                    {
                        @if (record.IsLocked)
                        {
                            <tr>
                                <td>
                                    <a href="/records/@record.Id" class="d-inline-flex align-items-center gap-2">
                                        <Icon Name="lock" /> <span>Sealed record</span>
                                    </a>
                                </td>
                                <td class="text-secondary">&mdash;</td>
                                <td class="text-secondary">&mdash;</td>
                                <td class="text-secondary">&mdash;</td>
                                <td class="text-secondary">&mdash;</td>
                                <td class="text-secondary">Created @RecordDisplay.Instant(record.CreatedAt)</td>
                            </tr>
                            continue;
                        }

                        <tr>
                            <td>
                                <a href="/records/@record.Id">@record.Title</a>
                                @if (record.IsServiceRecord)
                                {
                                    <span class="badge text-bg-info ms-2">Service record</span>
                                }
                                @if (record.IsSealed)
                                {
                                    <span class="badge text-bg-warning ms-2">Sealed</span>
                                }
                            </td>
                            <td><span class="badge text-bg-secondary">@RecordDisplay.AffiliationName(_affiliations, record.Affiliation ?? string.Empty)</span></td>
                            <td>
                                @if (_allScope && record.SubjectAccountId is not null)
                                {
                                    <button type="button" class="btn btn-link p-0 subject-filter" @onclick="() => FilterBySubjectAsync(record)">@record.SubjectDisplayName</button>
                                }
                                else
                                {
                                    @record.SubjectDisplayName
                                }
                            </td>
                            <td>@RecordDisplay.Engagement(record.EngagementStart, record.EngagementEnd)</td>
                            <td>@(record.ArtifactCount ?? 0)</td>
                            <td>@(record.UpdatedAt is { } updated ? RecordDisplay.Instant(updated) : string.Empty)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (PageCount > 1)
        {
            <nav aria-label="Record pages" class="d-flex align-items-center gap-3">
                <button type="button" id="previous-page" class="btn btn-outline-secondary btn-sm" disabled="@(_pageNumber <= 1)" @onclick="PreviousAsync">Previous</button>
                <span>Page @_pageNumber of @PageCount</span>
                <button type="button" id="next-page" class="btn btn-outline-secondary btn-sm" disabled="@(_pageNumber >= PageCount)" @onclick="NextAsync">Next</button>
            </nav>
        }
    }
}

@code {
    private const int PageSize = 20;

    private static readonly Crumb[] Crumbs = [new("Home", "/"), new("Citizen records")];

    private static readonly (string Value, string Label)[] SortOptions =
    [
        ("updatedDesc", "Recently updated"),
        ("updatedAsc", "Least recently updated"),
        ("titleAsc", "Title A-Z"),
        ("titleDesc", "Title Z-A"),
    ];

    private IReadOnlyList<AffiliationDto> _affiliations = [];
    private PagedResult<RecordSummaryDto>? _page;
    private string _affiliation = string.Empty;
    private string _sort = "updatedDesc";
    private int _pageNumber = 1;
    private bool _loadError;
    private bool _allScope;
    private Guid? _subjectId;
    private string _subjectName = string.Empty;

    private long PageCount => _page is null ? 1 : Math.Max(1, (_page.TotalCount + PageSize - 1) / PageSize);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _affiliations = await Api.GetAsync<List<AffiliationDto>>("api/affiliations") ?? [];
            await LoadUserAsync();
            await LoadAsync();
        }
        catch (ApiException)
        {
            _loadError = true;
        }
    }

    private async Task LoadUserAsync()
    {
        try
        {
            await User.EnsureLoadedAsync();
        }
        catch (ApiException)
        {
            // Without the account the Officer-only scope switch stays hidden; the Api enforces access either way.
        }
    }

    private async Task LoadAsync()
    {
        var path = $"api/records?page={_pageNumber}&pageSize={PageSize}&sort={_sort}";
        if (_affiliation.Length > 0)
        {
            path += $"&affiliation={Uri.EscapeDataString(_affiliation)}";
        }

        if (_allScope)
        {
            path += "&scope=all";
            if (_subjectId is { } subject)
            {
                path += $"&subjectAccountId={subject}";
            }
        }

        try
        {
            _page = await Api.GetAsync<PagedResult<RecordSummaryDto>>(path);
            _loadError = false;
        }
        catch (ApiException)
        {
            _loadError = true;
        }
    }

    private Task OnScopeChanged(ChangeEventArgs e) => SetScopeAsync(e.Value?.ToString() == "all");

    private async Task SetScopeAsync(bool all)
    {
        if (_allScope == all)
        {
            return;
        }

        _allScope = all;
        _subjectId = null;
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task FilterBySubjectAsync(RecordSummaryDto record)
    {
        _subjectId = record.SubjectAccountId;
        _subjectName = record.SubjectDisplayName ?? string.Empty;
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task ClearSubjectAsync()
    {
        _subjectId = null;
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task OnAffiliationChanged(ChangeEventArgs e)
    {
        _affiliation = e.Value?.ToString() ?? string.Empty;
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task OnSortChanged(ChangeEventArgs e)
    {
        _sort = e.Value?.ToString() ?? "updatedDesc";
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task PreviousAsync()
    {
        _pageNumber--;
        await LoadAsync();
    }

    private async Task NextAsync()
    {
        _pageNumber++;
        await LoadAsync();
    }
}
