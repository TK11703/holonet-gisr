<fieldset id="new-award" class="border rounded px-3 pb-3 mb-4">
    <legend class="float-none w-auto px-2 h6 mb-3">New award</legend>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="form-floating">
                <input id="new-award-name" type="text" class="@(_nameError is null ? "form-control" : "form-control is-invalid")" maxlength="200" placeholder="Name"
                       title="Required. The name of the award, up to 200 characters."
                       aria-required="true" aria-invalid="@(_nameError is null ? null : "true")" aria-describedby="@(_nameError is null ? null : "new-award-name-error")"
                       @bind="_draft.Name" />
                <label for="new-award-name">Name <span class="text-danger" aria-hidden="true">*</span></label>
            </div>
            @if (_nameError is not null)
            {
                <div id="new-award-name-error" class="invalid-feedback d-block">@_nameError</div>
            }
        </div>
        <div class="col-md-3">
            <div class="form-floating">
                <input id="new-award-date" type="date" class="@(_dateError is null ? "form-control" : "form-control is-invalid")" placeholder="Date awarded"
                       title="Required. The date the award was given."
                       aria-required="true" aria-invalid="@(_dateError is null ? null : "true")" aria-describedby="@(_dateError is null ? null : "new-award-date-error")"
                       @bind="_draft.AwardedOn" @bind:format="yyyy-MM-dd" />
                <label for="new-award-date">Date awarded <span class="text-danger" aria-hidden="true">*</span></label>
            </div>
            @if (_dateError is not null)
            {
                <div id="new-award-date-error" class="invalid-feedback d-block">@_dateError</div>
            }
        </div>
        <div class="col-md-3">
            <div class="form-floating">
                <input id="new-award-issuer" type="text" class="form-control" maxlength="200" placeholder="Issuer"
                       title="Optional. Who gave the award, up to 200 characters." @bind="_draft.Issuer" />
                <label for="new-award-issuer">Issuer</label>
            </div>
        </div>
        <div class="col-12">
            <div class="form-floating">
                <textarea id="new-award-description" class="form-control" rows="2" maxlength="2000" placeholder="Description"
                          title="Optional. Why the award was given, up to 2000 characters." @bind="_draft.Description"></textarea>
                <label for="new-award-description">Description</label>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <button type="button" id="add-award" class="btn btn-primary d-inline-flex align-items-center gap-2"
                disabled="@(Items.Count >= RecordFormModel.MaxItems)" @onclick="Add"><Icon Name="plus" /> Add award</button>
    </div>
</fieldset>

<section aria-labelledby="added-awards-heading">
    <h3 id="added-awards-heading" class="h6">Added awards</h3>
    @if (RecordDisplay.ErrorText(Errors, "awards") is { } listError)
    {
        <div id="awards-error" class="invalid-feedback d-block mb-2">@listError</div>
    }

    @if (Items.Count == 0)
    {
        <div id="awards-empty" class="alert alert-info d-flex align-items-start gap-2 mb-0" role="status">
            <span class="flex-shrink-0"><Icon Name="info" /></span>
            <span>No awards added yet.</span>
        </div>
    }
    else
    {
        <ul id="award-list" class="list-group">
            @for (var i = 0; i < Items.Count; i++)
            {
                var index = i;
                var item = Items[i];
                var itemError = RecordDisplay.ErrorText(Errors, $"awards[{index}].name")
                    ?? RecordDisplay.ErrorText(Errors, $"awards[{index}].awardedOn")
                    ?? RecordDisplay.ErrorText(Errors, $"awards[{index}].issuer")
                    ?? RecordDisplay.ErrorText(Errors, $"awards[{index}].description");

                <li class="list-group-item" id="@($"award-{index}")" @key="item">
                    <div class="d-flex w-100 justify-content-between align-items-start gap-3">
                        <div class="min-w-0">
                            <h4 class="h6 mb-1 text-break">@item.Name</h4>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p class="mb-1 pre-wrap text-break">@item.Description</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Issuer))
                            {
                                <div class="small text-secondary text-break">Issued by @item.Issuer</div>
                            }
                            @if (itemError is not null)
                            {
                                <div class="invalid-feedback d-block">@itemError</div>
                            }
                        </div>
                        <div class="d-flex flex-column align-items-end gap-2 flex-shrink-0">
                            @if (item.AwardedOn is { } date)
                            {
                                <time class="small text-secondary text-nowrap" datetime="@RecordDisplay.Date(date)">@RecordDisplay.Date(date)</time>
                            }
                            <button type="button" class="btn btn-outline-danger btn-sm d-inline-flex" title="Remove this award"
                                    aria-label="@($"Remove award {index + 1}")" @onclick="@(() => Items.Remove(item))"><Icon Name="delete" /></button>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
</section>

@code {
    private AwardModel _draft = new();
    private string? _nameError;
    private string? _dateError;

    [Parameter, EditorRequired]
    public List<AwardModel> Items { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<string, string[]> Errors { get; set; } = new Dictionary<string, string[]>();

    private void Add()
    {
        _nameError = string.IsNullOrWhiteSpace(_draft.Name) ? "Enter a name." : null;
        _dateError = _draft.AwardedOn is null ? "Enter the date awarded." : null;
        if (_nameError is not null || _dateError is not null)
        {
            return;
        }

        Items.Add(_draft);
        _draft = new AwardModel();
    }
}
