<section class="mb-4" aria-labelledby="new-award-heading">
    <h3 id="new-award-heading" class="h6">New award</h3>
    <div class="card card-body mb-3">
        <div class="row g-3">
            <div class="col-md-6">
                <label for="new-award-name" class="form-label">Name <span class="text-danger" aria-hidden="true">*</span></label>
                <input id="new-award-name" type="text" class="@(_nameError is null ? "form-control" : "form-control is-invalid")" maxlength="200"
                       aria-required="true" aria-invalid="@(_nameError is null ? null : "true")" aria-describedby="@(_nameError is null ? null : "new-award-name-error")"
                       @bind="_draft.Name" />
                @if (_nameError is not null)
                {
                    <div id="new-award-name-error" class="invalid-feedback d-block">@_nameError</div>
                }
            </div>
            <div class="col-md-3">
                <label for="new-award-date" class="form-label">Date awarded <span class="text-danger" aria-hidden="true">*</span></label>
                <input id="new-award-date" type="date" class="@(_dateError is null ? "form-control" : "form-control is-invalid")"
                       aria-required="true" aria-invalid="@(_dateError is null ? null : "true")" aria-describedby="@(_dateError is null ? null : "new-award-date-error")"
                       @bind="_draft.AwardedOn" @bind:format="yyyy-MM-dd" />
                @if (_dateError is not null)
                {
                    <div id="new-award-date-error" class="invalid-feedback d-block">@_dateError</div>
                }
            </div>
            <div class="col-md-3">
                <label for="new-award-issuer" class="form-label">Issuer</label>
                <input id="new-award-issuer" type="text" class="form-control" maxlength="200" @bind="_draft.Issuer" />
            </div>
            <div class="col-12">
                <label for="new-award-description" class="form-label">Description</label>
                <textarea id="new-award-description" class="form-control" rows="2" maxlength="2000" @bind="_draft.Description"></textarea>
            </div>
        </div>
        <div class="mt-3">
            <button type="button" id="add-award" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-2"
                    disabled="@(Items.Count >= RecordFormModel.MaxItems)" @onclick="Add"><Icon Name="plus" /> Add award</button>
        </div>
    </div>
</section>

<section aria-labelledby="added-awards-heading">
    <h3 id="added-awards-heading" class="h6">Added awards</h3>
    @if (RecordDisplay.ErrorText(Errors, "awards") is { } listError)
    {
        <div id="awards-error" class="invalid-feedback d-block mb-2">@listError</div>
    }

    @if (Items.Count == 0)
    {
        <p id="awards-empty" class="text-secondary">No awards added yet.</p>
    }

    @for (var i = 0; i < Items.Count; i++)
    {
        var index = i;
        var item = Items[i];
        var prefix = $"award-{index}";
        var name = RecordDisplay.ErrorText(Errors, $"awards[{index}].name");
        var date = RecordDisplay.ErrorText(Errors, $"awards[{index}].awardedOn");
        var issuer = RecordDisplay.ErrorText(Errors, $"awards[{index}].issuer");
        var description = RecordDisplay.ErrorText(Errors, $"awards[{index}].description");

        <div class="card mb-3" @key="item">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="@($"{prefix}-name")" class="form-label">Name <span class="text-danger" aria-hidden="true">*</span></label>
                        <input id="@($"{prefix}-name")" type="text" class="@(name is null ? "form-control" : "form-control is-invalid")" maxlength="200"
                               aria-required="true" aria-invalid="@(name is null ? null : "true")" aria-describedby="@(name is null ? null : $"{prefix}-name-error")"
                               @bind="item.Name" />
                        @if (name is not null)
                        {
                            <div id="@($"{prefix}-name-error")" class="invalid-feedback d-block">@name</div>
                        }
                    </div>
                    <div class="col-md-3">
                        <label for="@($"{prefix}-date")" class="form-label">Date awarded <span class="text-danger" aria-hidden="true">*</span></label>
                        <input id="@($"{prefix}-date")" type="date" class="@(date is null ? "form-control" : "form-control is-invalid")"
                               aria-required="true" aria-invalid="@(date is null ? null : "true")" aria-describedby="@(date is null ? null : $"{prefix}-date-error")"
                               @bind="item.AwardedOn" @bind:format="yyyy-MM-dd" />
                        @if (date is not null)
                        {
                            <div id="@($"{prefix}-date-error")" class="invalid-feedback d-block">@date</div>
                        }
                    </div>
                    <div class="col-md-3">
                        <label for="@($"{prefix}-issuer")" class="form-label">Issuer</label>
                        <input id="@($"{prefix}-issuer")" type="text" class="@(issuer is null ? "form-control" : "form-control is-invalid")" maxlength="200"
                               aria-invalid="@(issuer is null ? null : "true")" aria-describedby="@(issuer is null ? null : $"{prefix}-issuer-error")"
                               @bind="item.Issuer" />
                        @if (issuer is not null)
                        {
                            <div id="@($"{prefix}-issuer-error")" class="invalid-feedback d-block">@issuer</div>
                        }
                    </div>
                    <div class="col-12">
                        <label for="@($"{prefix}-description")" class="form-label">Description</label>
                        <textarea id="@($"{prefix}-description")" class="@(description is null ? "form-control" : "form-control is-invalid")" rows="2" maxlength="2000"
                                  aria-invalid="@(description is null ? null : "true")" aria-describedby="@(description is null ? null : $"{prefix}-description-error")"
                                  @bind="item.Description"></textarea>
                        @if (description is not null)
                        {
                            <div id="@($"{prefix}-description-error")" class="invalid-feedback d-block">@description</div>
                        }
                    </div>
                </div>
                <button type="button" class="btn btn-outline-danger btn-sm mt-3" aria-label="@($"Remove award {index + 1}")"
                        @onclick="@(() => Items.Remove(item))">Remove</button>
            </div>
        </div>
    }
</section>

@code {
    private AwardModel _draft = new();
    private string? _nameError;
    private string? _dateError;

    [Parameter, EditorRequired]
    public List<AwardModel> Items { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<string, string[]> Errors { get; set; } = new Dictionary<string, string[]>();

    private void Add()
    {
        _nameError = string.IsNullOrWhiteSpace(_draft.Name) ? "Enter a name." : null;
        _dateError = _draft.AwardedOn is null ? "Enter the date awarded." : null;
        if (_nameError is not null || _dateError is not null)
        {
            return;
        }

        Items.Add(_draft);
        _draft = new AwardModel();
    }
}
