@if (Affiliation is not null)
{
    @foreach (var field in Affiliation.Fields)
    {
        var id = $"detail-{field.Key}";
        var errorId = $"{id}-error";
        var error = RecordDisplay.ErrorText(Errors, $"engagementDetail.{field.Key}");
        var value = Detail.TryGetValue(field.Key, out var current) ? current : string.Empty;
        var invalid = error is null ? null : "true";
        var required = field.Required ? "true" : null;
        var describedBy = error is null ? null : errorId;
        var css = error is null ? "form-control" : "form-control is-invalid";

        <div class="mb-3">
            <label for="@id" class="form-label">
                @field.Label
                @if (field.Required)
                {
                    <span class="text-danger" aria-hidden="true">*</span>
                    <span class="visually-hidden">(required)</span>
                }
            </label>
            @switch (field.InputType)
            {
                case "multiline":
                    <textarea id="@id" class="@css" rows="5" maxlength="@field.MaxLength" value="@value"
                              aria-required="@required" aria-invalid="@invalid" aria-describedby="@describedBy"
                              @onchange="@(e => Set(field.Key, e.Value?.ToString()))"></textarea>
                    break;
                case "select":
                    <select id="@id" class="@(error is null ? "form-select" : "form-select is-invalid")" value="@value"
                            aria-required="@required" aria-invalid="@invalid" aria-describedby="@describedBy"
                            @onchange="@(e => Set(field.Key, e.Value?.ToString()))">
                        <option value="">Select...</option>
                        @foreach (var option in field.Options ?? [])
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                    break;
                default:
                    <input id="@id" type="text" class="@css" maxlength="@field.MaxLength" value="@value"
                           aria-required="@required" aria-invalid="@invalid" aria-describedby="@describedBy"
                           @onchange="@(e => Set(field.Key, e.Value?.ToString()))" />
                    break;
            }
            @if (error is not null)
            {
                <div id="@errorId" class="invalid-feedback d-block">@error</div>
            }
        </div>
    }
}

@code {
    [Parameter, EditorRequired]
    public AffiliationDto? Affiliation { get; set; }

    [Parameter, EditorRequired]
    public Dictionary<string, string> Detail { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<string, string[]> Errors { get; set; } = new Dictionary<string, string[]>();

    private void Set(string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            Detail.Remove(key);
        }
        else
        {
            Detail[key] = value;
        }
    }
}
