@page "/not-found"
@attribute [AllowAnonymous]
@layout MainLayout
@inject IJSRuntime JS

<div id="not-found" class="error-page">
    <div class="error-code" aria-hidden="true">404</div>
    <h1 class="error-title"><span class="visually-hidden">Error 404. </span>Oops!</h1>
    <h2 class="error-subtitle">We can't seem to find the page you're looking for</h2>
    <hr class="error-divider" />
    <p class="error-help">Here are some helpful links instead:</p>
    <div class="error-links">
        <button type="button" id="not-found-back" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" @onclick="GoBackAsync">
            <Icon Name="back" /> Back
        </button>
        <a class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" href="/"><Icon Name="home" /> Home</a>
    </div>
</div>

@code {
    private async Task GoBackAsync() => await JS.InvokeVoidAsync("history.back");
}
