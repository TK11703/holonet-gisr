@inject CurrentUserState User
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark" data-gisr-theme="@_theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="@Assets["gisr-mark.svg"]" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["theme.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private string _theme = SiteThemes.Default;

    // The same scoped state is reused by the prerendered page, so this adds no extra API call.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await User.EnsureLoadedAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // A theme must never stop the page rendering; the page reports its own load failure.
            return;
        }

        if (User.Account is { } account && SiteThemes.IsKnown(account.Theme))
        {
            _theme = account.Theme;
        }
    }
}
