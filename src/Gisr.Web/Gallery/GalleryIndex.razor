@page "/gallery"
@inject ApiClient Api
@inject CurrentUserState User

<PageHeader Title="List of galleries" Crumbs="Crumbs" />

@if (!_loadError && _page is not null && (User.IsOfficer || _page.TotalCount > 0))
{
    <div class="d-flex flex-wrap gap-3 align-items-end mb-3">
        @if (User.IsOfficer)
        {
            <div class="form-floating">
                <select id="filter-scope" class="form-select" value="@(_allScope ? "all" : "mine")"
                        @onchange="OnScopeChanged">
                    <option value="mine">My records</option>
                    <option value="all">All records</option>
                </select>
                <label for="filter-scope">Gallery Owner</label>
            </div>
        }
        <div class="form-floating">
            <select id="sort" class="form-select" value="@_sort" @onchange="OnSortChanged">
                @foreach (var (value, label) in SortOptions)
                {
                    <option value="@value">@label</option>
                }
            </select>
            <label for="sort">Sort by</label>
        </div>
        <div class="form-floating page-size-field">
            <select id="page-size" class="form-select" value="@_pageSize" @onchange="OnPageSizeChanged">
                @foreach (var size in PageSizes)
                {
                    <option value="@size">@size</option>
                }
            </select>
            <label for="page-size">Page Size</label>
        </div>
    </div>
}

@if (_loadError)
{
    <div class="alert alert-danger" role="alert">The gallery could not be loaded. Please try again.</div>
}
else if (_page is null)
{
    <p class="text-secondary" role="status">Loading...</p>
}
else if (_page.TotalCount == 0)
{
    <section id="gallery-empty" class="card">
        <div class="card-body">
            <h2 class="h5">No images yet</h2>
            <p class="text-secondary">Images you add to a record appear here, grouped by record. Open a record, choose Edit, and add an image under Artifacts.</p>
            <a class="btn btn-primary" href="/records">Go to citizen records</a>
        </div>
    </section>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-3">
        @foreach (var group in _page.Items)
        {
            <div class="col">
                <div class="card gallery-card h-100">
                    <div class="gallery-covers">
                        @foreach (var cover in group.CoverArtifactIds.Take(4))
                        {
                            <img src="@ArtifactDisplay.MediaUrl(cover, true, null)" alt="" loading="lazy" />
                        }
                    </div>
                    <div class="card-body">
                        <h2 class="h6 card-title mb-1">
                            <a class="gallery-card-link stretched-link" href="/gallery/@group.RecordId">@group.Title</a>
                        </h2>
                        <span class="badge text-bg-secondary">@group.Affiliation</span>
                        <span class="small text-secondary ms-1">@(group.ImageCount == 1 ? "1 image" : $"{group.ImageCount} images")</span>
                        @if (_allScope)
                        {
                            <div class="small text-secondary">@group.SubjectDisplayName</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (PageCount > 1)
    {
        <nav aria-label="Gallery pages" class="d-flex align-items-center gap-3">
            <button type="button" id="previous-page" class="btn btn-outline-secondary btn-sm" disabled="@(_pageNumber <= 1)" @onclick="PreviousAsync">Previous</button>
            <span>Page @_pageNumber of @PageCount</span>
            <button type="button" id="next-page" class="btn btn-outline-secondary btn-sm" disabled="@(_pageNumber >= PageCount)" @onclick="NextAsync">Next</button>
        </nav>
    }
}

@code {
    private static readonly int[] PageSizes = [10, 25, 50, 100];

    private static readonly Crumb[] Crumbs = [new("Home", "/"), new("Gallery")];

    private static readonly (string Value, string Label)[] SortOptions =
    [
        ("updatedDesc", "Recently updated"),
        ("titleAsc", "Title A-Z"),
        ("titleDesc", "Title Z-A"),
    ];

    private PagedResult<GalleryGroupDto>? _page;
    private int _pageNumber = 1;
    private int _pageSize = 25;
    private string _sort = "updatedDesc";
    private bool _allScope;
    private bool _loadError;

    private long PageCount => _page is null ? 1 : Math.Max(1, (_page.TotalCount + _pageSize - 1) / _pageSize);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadUserAsync();
            await LoadAsync();
        }
        catch (ApiException)
        {
            _loadError = true;
        }
    }

    private async Task LoadUserAsync()
    {
        try
        {
            await User.EnsureLoadedAsync();
        }
        catch (ApiException)
        {
            // Without the account the Officer-only scope switch stays hidden; the Api enforces access either way.
        }
    }

    private async Task LoadAsync()
    {
        var path = $"api/gallery?page={_pageNumber}&pageSize={_pageSize}&sort={_sort}";
        if (_allScope)
        {
            path += "&scope=all";
        }

        try
        {
            _page = await Api.GetAsync<PagedResult<GalleryGroupDto>>(path);
            _loadError = false;
        }
        catch (ApiException)
        {
            _loadError = true;
        }
    }

    private Task OnScopeChanged(ChangeEventArgs e) => SetScopeAsync(e.Value?.ToString() == "all");

    private async Task SetScopeAsync(bool all)
    {
        if (_allScope == all)
        {
            return;
        }

        _allScope = all;
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task OnSortChanged(ChangeEventArgs e)
    {
        _sort = e.Value?.ToString() ?? "updatedDesc";
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        _pageSize = int.TryParse(e.Value?.ToString(), out var size) && PageSizes.Contains(size) ? size : _pageSize;
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task PreviousAsync()
    {
        _pageNumber--;
        await LoadAsync();
    }

    private async Task NextAsync()
    {
        _pageNumber++;
        await LoadAsync();
    }
}
